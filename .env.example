# Server Configuration
APP_ADDR=:8080
STATIC_DIR=./web
BACKUP_DIR=./backups
DATA_DIR=./data
PROFILE_ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Default Login Form Prefills (non-secret; passwords are always entered at login)
DEFAULT_ENGINE=postgres
DEFAULT_HOST=127.0.0.1
DEFAULT_PORT=5432
DEFAULT_DATABASE=postgres
DEFAULT_USERNAME=postgres
DEFAULT_SSLMODE=disable

# Backup Tool Paths (auto-detected from PATH if left as command names)
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
PSQL_PATH=psql
MYSQL_DUMP_PATH=mysqldump
MYSQL_PATH=mysql

# Optional Scheduled Daily Backup (runs in background when AUTO_BACKUP_ENABLED=true)
AUTO_BACKUP_ENABLED=false
AUTO_BACKUP_TIME=03:00
AUTO_BACKUP_DSN=
AUTO_BACKUP_RETENTION_DAYS=14
